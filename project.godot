; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cascabel"
run/main_scene="res://render/mesa.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

; LA MÚSICA VA POR DEBAJO DE LOS EFECTOS, y no es gusto: es la regla de mezcla
; de `assets/prompts_musica.md` §3. Los efectos de `sonidos.py` son ondas
; cuadradas que ocupan de 150 Hz a 1 kHz y suenan CONSTANTEMENTE, así que una
; música al mismo nivel convierte cada bola en un barrizal. Los -8 dB del bus
; `Musica` son el sitio donde eso se arregla de una vez para las ocho piezas,
; en lugar de bajarle el volumen a cada una por separado.
buses/default_bus_layout="res://audio_bus_layout.tres"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
